{
  "name": "localcraft",
  "private": true,
  "version": "0.1.0",
  "description": "A toolbox for developers and everyday work that runs entirely in your browser. Zero servers, 100% private, works offline.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/sync-ffmpeg.mjs && vite",
    "build": "node scripts/sync-ffmpeg.mjs && tsc --noEmit && vite build && vite build --ssr scripts/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@imgly/background-removal": "^1.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "bwip-js": "^4.11.4",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.46.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sql-formatter": "^15.8.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.20.3",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
